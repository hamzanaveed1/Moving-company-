# ---- Required for launch ----
# Public site URL used for canonicals, sitemap, social tags and the form Origin check
SITE_URL=https://movingpal.co.uk
# Contact for vulnerability reports (published in /.well-known/security.txt)
SECURITY_CONTACT=mailto:security@movingpal.co.uk

# ---- Quote form ----
# On Vercel and Cloudflare Pages this is set automatically to /api/quote (the bundled function).
# Elsewhere, point it at Formspree / Web3Forms / your own API (https URL).
PUBLIC_FORM_ENDPOINT=
PUBLIC_FORM_ACCESS_KEY=

# ---- Form function secrets (set in the Vercel / Cloudflare dashboard, NOT in this file) ----
# RESEND_API_KEY, TO_EMAIL, FROM_EMAIL, SITE_URL

# ---- Google AdSense (leave empty until approved; see docs/ADSENSE.md) ----
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT=

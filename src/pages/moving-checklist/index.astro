---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbSchema } from '../../lib/seo';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Moving checklist', href: '/moving-checklist/' }];
const groups = [
  { id: '8w', title: '8 weeks before', items: ['Set a moving budget', 'Start decluttering room by room', 'Get at least three written removal quotes', 'Check notice periods in your tenancy or contract', 'Choose your moving date'] },
  { id: '6w', title: '6 weeks before', items: ['Book your removal company and confirm in writing', 'Book packing help if needed', 'Order boxes, tape and packing paper', 'Tell your landlord or letting agent', 'Check parking rules and book building lifts'] },
  { id: '4w', title: '4 weeks before', items: ['Order broadband at the new address', 'Plan utility transfers and final meter readings', 'Start packing rarely used items', 'Arrange time off work', 'Arrange childcare or pet care for moving day', 'Check contents insurance starts at the new home'] },
  { id: '2w', title: '2 weeks before', items: ['Set up Royal Mail redirection', 'Update your address with banks, insurers, employer and HMRC', 'Update your driving licence and vehicle details with the DVLA', 'Update the electoral register and council tax', 'Update TV Licensing and subscriptions', 'Register with a new GP and dentist if needed', 'Contact the new council about school places if relevant'] },
  { id: '1w', title: '1 week before', items: ['Pack everything except essentials', 'Label boxes by room and mark fragile ones', 'Defrost the freezer', 'Arrange to disconnect appliances', 'Pack a first-night essentials box', 'Arrange key handover at both ends', 'Confirm timings and contact numbers with your crew'] },
  { id: 'day', title: 'Moving day', items: ['Take final meter readings and photos', 'Keep documents, medication, valuables and chargers with you', 'Strip beds and pack first-night bedding', 'Do a final walk-through of every room, loft and garage', 'Hand over keys as agreed', 'Check delivery against your inventory and note any damage'] },
  { id: 'after', title: 'First week in the new home', items: ['Check meter readings and utilities', 'Change the locks if you can', 'Test smoke and carbon monoxide alarms', 'Find the stopcock and fuse box', 'Update remaining accounts and loyalty cards', 'Break down and recycle boxes'] },
];
---
<BaseLayout title="Free Moving House Checklist (UK) | Printable & Interactive" description="A free, interactive UK moving checklist from 8 weeks before to your first week in your new home. Tick items off, track progress and print it." schema={[breadcrumbSchema(crumbs)]}>
  <PageHero eyebrow="Free tool" h1="Your UK moving house checklist" lead="Tick items off as you go. Your progress is saved in your browser only, and you can print the list." crumbs={crumbs} actions={false} />
  <section class="section">
    <div class="container narrow">
      <div class="todo-bar" aria-live="polite"><span data-count>0 / 0 done</span><div class="bar" role="progressbar" aria-label="Checklist progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><i data-bar></i></div><button class="btn btn-ghost" style="min-height:38px;padding:.4rem 1rem" type="button" data-print>Print</button></div>
      <div class="stack" style="--gap:1.5rem">
        {groups.map((g) => (
          <section class="todo-group" data-group={g.id}>
            <h2>{g.title}<small data-gcount>0/{g.items.length}</small></h2>
            {g.items.map((it, i) => (
              <label class="todo"><input type="checkbox" data-key={`${g.id}-${i}`} /><span>{it}</span></label>
            ))}
          </section>
        ))}
      </div>
      <p class="mt-2"><button class="btn btn-ghost" type="button" data-reset>Reset checklist</button></p>
      <div class="prose mt-3">
        <h2>Want the full detail?</h2>
        <p>Our <a href="/blog/moving-house-checklist-uk/">8-week moving checklist guide</a> explains each step. Our <a href="/blog/how-to-pack-for-a-house-move/">packing guide</a> shows how to pack room by room, and our <a href="/blog/how-much-does-moving-house-cost-uk/">cost guide</a> helps with your budget.</p>
      </div>
    </div>
  </section>
  <CtaBand title="Want the heavy lifting handled?" text="Tick 'book removals' off your list in two minutes. Get a fixed-price quote." />
</BaseLayout>

<script>
  const KEY = 'moving-checklist-v1';
  const boxes = [...document.querySelectorAll<HTMLInputElement>('input[data-key]')];
  let saved: Record<string, boolean> = {};
  try { saved = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { saved = {}; }
  boxes.forEach((b) => { b.checked = !!saved[b.dataset.key!]; });
  const countEl = document.querySelector('[data-count]')!;
  const barEl = document.querySelector<HTMLElement>('[data-bar]')!;
  const progress = document.querySelector('[role=progressbar]')!;
  const render = () => {
    const done = boxes.filter((b) => b.checked).length;
    const pct = Math.round((done / boxes.length) * 100);
    countEl.textContent = `${done} / ${boxes.length} done`;
    barEl.style.width = pct + '%';
    progress.setAttribute('aria-valuenow', String(pct));
    document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
      const inGroup = [...g.querySelectorAll<HTMLInputElement>('input')];
      g.querySelector('[data-gcount]')!.textContent = `${inGroup.filter((i) => i.checked).length}/${inGroup.length}`;
    });
  };
  const save = () => {
    const out: Record<string, boolean> = {};
    boxes.forEach((b) => { if (b.checked) out[b.dataset.key!] = true; });
    try { localStorage.setItem(KEY, JSON.stringify(out)); } catch { /* storage unavailable */ }
  };
  boxes.forEach((b) => b.addEventListener('change', () => { save(); render(); }));
  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    if (confirm('Reset all ticks?')) { boxes.forEach((b) => (b.checked = false)); save(); render(); }
  });
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  render();
</script>

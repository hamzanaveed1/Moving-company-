---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<BaseLayout title="Thank You | Quote Request Received" description="We have received your quote request and will be in touch shortly with a written fixed-price quote for your move." noindex>
  <section class="section">
    <div class="container narrow center">
      <div class="icon-box" style="margin-inline:auto;color:var(--green-600)"><Icon name="check" /></div>
      <h1 style="font-size:clamp(2rem,4vw,3rem)">Thanks, we have your request</h1>
      <p class="lead">We will review your details and come back to you with a written fixed-price quote. If we need to clarify anything, we will email you first.</p>
      <p>Need to add something or move quickly? Email <a href={`mailto:${site.email}`}><strong>{site.email}</strong></a>.</p>
      <p class="mt-2"><a class="btn btn-ghost" href="/moving-checklist/">Use our free moving checklist</a> <a class="btn btn-ghost" href="/blog/">Read moving guides</a></p>
    </div>
  </section>
</BaseLayout>

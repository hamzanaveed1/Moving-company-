---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'>; eager?: boolean }
const { post, eager = false } = Astro.props;
const d = post.data;
const date = d.publishedAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<a class="card post-card" href={`/blog/${post.id}/`}>
  <div class="thumb">
    <Image src={d.image} alt={d.imageAlt} width={640} height={360} widths={[360, 640, 960]} sizes="(max-width: 700px) 92vw, 380px" loading={eager ? 'eager' : 'lazy'} format="webp" />
  </div>
  <div class="body">
    <span class="tag">{d.category}</span>
    <h3>{d.title}</h3>
    <p>{d.description}</p>
    <div class="meta">{date} · {d.readingTime} min read</div>
  </div>
</a>

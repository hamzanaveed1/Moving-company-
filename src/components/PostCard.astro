---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'>; eager?: boolean; level?: 2 | 3 }
const { post, eager = false, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const d = post.data;
const date = d.publishedAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<a class="card post-card" href={`/blog/${post.id}/`}>
  <div class="thumb">
    <Picture formats={['avif', 'webp']} src={d.image} alt={d.imageAlt} width={640} height={360} widths={[360, 640, 960]} sizes="(max-width: 700px) 92vw, 380px" loading={eager ? 'eager' : 'lazy'} />
  </div>
  <div class="body">
    <span class="tag">{d.category}</span>
    <Heading>{d.title}</Heading>
    <p>{d.description}</p>
    <div class="meta">{date} · {d.readingTime} min read</div>
  </div>
</a>

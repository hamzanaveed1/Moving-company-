---
import { site } from '../data/site';
interface Props { light?: boolean }
const { light = false } = Astro.props; // light = the version for dark backgrounds (footer)
// Mark: the Loadby parcel-with-forward-arrow. Wordmark: "Load" + "by" in the brand font.
// Artwork source: scripts/logo-mark.json (rebuilt into public/logo-mark*.svg by `npm run images`).
const name = site.name; // "Loadby"
const head = name.slice(0, 4);
const tail = name.slice(4);
const src = light ? '/logo-mark-light.svg' : '/logo-mark.svg';
---
<a href="/" class="brand" aria-label={`${name} home`}>
  <img class="brand-mark" src={src} width="37" height="41" alt="" decoding="async" />
  <span class="brand-name">{head}<span>{tail}</span></span>
</a>

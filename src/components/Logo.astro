---
import { site } from '../data/site';
interface Props { light?: boolean }
const { light = false } = Astro.props; // light = always use the version for dark backgrounds (footer)
// Mark: the parcel-with-forward-arrow. Wordmark: "Moving" + "Pal" in the brand font (split before the last capital letter).
// Artwork source: scripts/logo-mark.json (rebuilt into public/logo-mark*.svg by `npm run images`).
const name = site.name; // "MovingPal"
const split = name.match(/^(.+?)([A-Z][a-z]*)$/);
const head = split ? split[1] : name;
const tail = split ? split[2] : '';
---
<a href="/" class="brand" aria-label={`${name} home`}>
  {light ? (
    <img class="brand-mark" src="/logo-mark-light.svg" width="37" height="41" alt="" decoding="async" />
  ) : (
    <>
      <img class="brand-mark brand-mark--lt" src="/logo-mark.svg" width="37" height="41" alt="" decoding="async" />
      <img class="brand-mark brand-mark--dk" src="/logo-mark-light.svg" width="37" height="41" alt="" decoding="async" />
    </>
  )}
  <span class="brand-name">{head}<span>{tail}</span></span>
</a>

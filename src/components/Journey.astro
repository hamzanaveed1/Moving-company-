---
import Icon from './Icon.astro';
// "How it works". When the section scrolls into view a van drives along a road in about two seconds and each stop
// lights up as it arrives, ending at a "home" marker. Geometry is measured by src/scripts/home.ts.
// Without JavaScript (or with reduced motion) every step is simply shown.
const steps = [
  { t: 'Tell us about your move', p: 'Two minutes online. Postcodes, size, date and any access issues.' },
  { t: 'Get a fixed quote', p: 'A clear written price, the van and crew we plan to send, and what is included.' },
  { t: 'We plan the details', p: 'Timings, parking, lift bookings and optional packing are agreed before the day.' },
  { t: 'Moving day, handled', p: 'We protect, load, drive, unload and place everything where you want it.' },
];
---
<div class="journey" data-journey>
  <div class="journey-track" aria-hidden="true">
    <span class="jt-line"></span>
    <span class="jt-fill"></span>
    <span class="jt-van">
      <span class="jt-beam"></span>
      <span class="jt-speed"><i></i><i></i><i></i></span>
      <svg viewBox="0 0 64 40" focusable="false">
        <ellipse cx="31" cy="38" rx="27" ry="2.4" fill="#0c1f3d" opacity=".2" />
        <rect x="2" y="6" width="38" height="24" rx="4" fill="#fff" stroke="#0c1f3d" stroke-width="1.6" />
        <rect x="2" y="21" width="38" height="5" fill="#12305c" /><rect x="2" y="15" width="38" height="2.4" fill="#f5a524" />
        <path d="M40 11h9.5a5 5 0 0 1 4 2l5 7.5a4 4 0 0 1 .8 2.4V30H40V11Z" fill="#fff" stroke="#0c1f3d" stroke-width="1.6" stroke-linejoin="round" />
        <path d="M44 14.5h5a3 3 0 0 1 2.4 1.2l3 4.3H44v-5.5Z" fill="#a9d4f0" />
        <rect x="58" y="22" width="3.4" height="3" rx="1" fill="#ffd27a" />
        {[14, 49].map((cx) => (
          <g>
            <circle cx={cx} cy="31" r="5.4" fill="#161b27" />
            <g class="jt-wheel" style={`transform-origin:${cx}px 31px`}>
              <circle cx={cx} cy="31" r="3.2" fill="#cfd6e4" />
              <path d={`M${cx} 28.2v5.6M${cx - 2.8} 31h5.6`} stroke="#161b27" stroke-width="1.2" stroke-linecap="round" />
            </g>
          </g>
        ))}
      </svg>
      <svg class="jt-top" viewBox="0 0 30 58" focusable="false">
        <ellipse cx="15" cy="55" rx="10" ry="2.4" fill="#0c1f3d" opacity=".18" />
        <rect x="0.6" y="8" width="3.2" height="10" rx="1.2" fill="#161b27" /><rect x="26.2" y="8" width="3.2" height="10" rx="1.2" fill="#161b27" />
        <rect x="0.6" y="38" width="3.2" height="10" rx="1.2" fill="#161b27" /><rect x="26.2" y="38" width="3.2" height="10" rx="1.2" fill="#161b27" />
        <rect x="3" y="2" width="24" height="38" rx="5" fill="#fff" stroke="#0c1f3d" stroke-width="1.4" />
        <rect x="3" y="28" width="24" height="3" fill="#f5a524" />
        <rect x="9" y="8" width="12" height="12" rx="3" fill="#0c1f3d" /><path d="M12.4 11.2v5.4h4.6" fill="none" stroke="#f5a524" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="4.5" y="38" width="21" height="17" rx="6" fill="#fff" stroke="#0c1f3d" stroke-width="1.4" />
        <rect x="7.5" y="41" width="15" height="6" rx="2" fill="#a9d4f0" />
        <circle cx="8.5" cy="52" r="1.7" fill="#ffd27a" /><circle cx="21.5" cy="52" r="1.7" fill="#ffd27a" />
      </svg>
    </span>
    <span class="jt-end"><Icon name="home" /></span>
  </div>
  <ol class="journey-steps">
    {steps.map((s, i) => (
      <li data-step>
        <span class="jt-dot" aria-hidden="true"><b>{i + 1}</b></span>
        <h3>{s.t}</h3>
        <p>{s.p}</p>
      </li>
    ))}
  </ol>
</div>

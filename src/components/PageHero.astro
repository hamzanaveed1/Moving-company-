---
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import type { Crumb } from '../lib/seo';
interface Props { eyebrow?: string; h1: string; lead?: string; crumbs?: Crumb[]; quoteHref?: string; actions?: boolean }
const { eyebrow, h1, lead, crumbs, quoteHref = '/get-a-quote/', actions = true } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    {crumbs && <Breadcrumbs crumbs={crumbs} />}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{h1}</h1>
    {lead && <p class="lead">{lead}</p>}
    {actions && (
      <div class="actions">
        <a class="btn btn-primary btn-lg" href={quoteHref}>Get a free quote <Icon name="arrow" /></a>
        <a class="btn btn-ghost btn-lg" href={`mailto:${site.email}`}><Icon name="mail" /> Email us</a>
      </div>
    )}
    <slot />
  </div>
</section>

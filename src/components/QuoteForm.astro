---
import Icon from './Icon.astro';
import { site } from '../data/site';

const moveTypes = [
  ['house', 'House move'],
  ['flat', 'Flat / apartment'],
  ['office', 'Office / business'],
  ['student', 'Student / small move'],
  ['storage', 'Storage only'],
];
const sizes = [
  'Studio / a few items', '1 bedroom', '2 bedrooms', '3 bedrooms', '4 bedrooms', '5+ bedrooms', 'Office (small, 1–10 desks)', 'Office (larger)',
];
const access = [
  'Ground floor / house with easy access',
  'Flat with a working lift',
  'Stairs, 1–2 floors (no lift)',
  'Stairs, 3+ floors (no lift)',
  'Not sure',
];
const extras = [
  ['packing', 'Packing service'],
  ['materials', 'Boxes and materials'],
  ['dismantle', 'Dismantle / rebuild furniture'],
  ['storage', 'Storage'],
  ['appliances', 'Disconnect appliances'],
  ['piano', 'Piano / very heavy items'],
];
---
<form class="form-card" id="quote-form" novalidate data-endpoint={site.formEndpoint} data-key={site.formAccessKey} data-email={site.email} data-brand={site.name}>
  <ol class="progress" aria-hidden="true">
    <li class="active"><span>Your move</span></li>
    <li><span>Addresses</span></li>
    <li><span>Date & extras</span></li>
    <li><span>Contact</span></li>
  </ol>

  <!-- Honeypot: real people never see or fill this -->
  <div class="hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

  <section class="step active" data-step="0" aria-labelledby="s0">
    <h2 id="s0" tabindex="-1">What are you moving?</h2>
    <fieldset class="field">
      <legend>Type of move <span class="hint">(required)</span></legend>
      <div class="choice-grid">
        {moveTypes.map(([, l]) => (
          <label class="choice"><input type="radio" name="moveType" value={l} required /><span>{l}</span></label>
        ))}
      </div>
      <span class="error-msg" data-err="moveType"></span>
    </fieldset>
    <div class="field">
      <label for="size">Property size</label>
      <select id="size" name="size" required>
        <option value="">Select size…</option>
        {sizes.map((s) => <option>{s}</option>)}
      </select>
      <span class="error-msg" data-err="size"></span>
    </div>
  </section>

  <section class="step" data-step="1" aria-labelledby="s1">
    <h2 id="s1" tabindex="-1">Where are you moving from and to?</h2>
    <div class="form-grid">
      <div class="field">
        <label for="fromPostcode">Moving from (postcode)</label>
        <input id="fromPostcode" name="fromPostcode" type="text" autocomplete="postal-code" placeholder="e.g. M1 1AA" required />
        <span class="error-msg" data-err="fromPostcode"></span>
      </div>
      <div class="field">
        <label for="toPostcode">Moving to (postcode)</label>
        <input id="toPostcode" name="toPostcode" type="text" placeholder="e.g. B1 1AA" required />
        <span class="error-msg" data-err="toPostcode"></span>
      </div>
      <div class="field">
        <label for="fromAccess">Access at pick-up</label>
        <select id="fromAccess" name="fromAccess" required>
          <option value="">Select…</option>
          {access.map((a) => <option>{a}</option>)}
        </select>
        <span class="error-msg" data-err="fromAccess"></span>
      </div>
      <div class="field">
        <label for="toAccess">Access at delivery</label>
        <select id="toAccess" name="toAccess" required>
          <option value="">Select…</option>
          {access.map((a) => <option>{a}</option>)}
        </select>
        <span class="error-msg" data-err="toAccess"></span>
      </div>
    </div>
    <p class="form-note">Parking close to the door? Long carries or restricted streets change the crew and time we plan, so add details in the notes on the next step.</p>
  </section>

  <section class="step" data-step="2" aria-labelledby="s2">
    <h2 id="s2" tabindex="-1">When, and what else do you need?</h2>
    <div class="form-grid">
      <div class="field">
        <label for="moveDate">Preferred moving date</label>
        <input id="moveDate" name="moveDate" type="date" required />
        <span class="error-msg" data-err="moveDate"></span>
      </div>
      <fieldset class="field">
        <legend>Is your date flexible?</legend>
        <div class="choice-grid">
          <label class="choice"><input type="radio" name="flexible" value="Fixed date" checked /><span>Fixed date</span></label>
          <label class="choice"><input type="radio" name="flexible" value="± 1–3 days" /><span>± 1–3 days</span></label>
          <label class="choice"><input type="radio" name="flexible" value="Very flexible" /><span>Very flexible</span></label>
        </div>
      </fieldset>
    </div>
    <fieldset class="field">
      <legend>Extras <span class="hint">(optional)</span></legend>
      <div class="choice-grid">
        {extras.map(([, l]) => <label class="choice"><input type="checkbox" name="extras" value={l} /><span>{l}</span></label>)}
      </div>
    </fieldset>
    <div class="field">
      <label for="notes">Anything we should know? <span class="hint">(optional)</span></label>
      <textarea id="notes" name="notes" placeholder="Parking restrictions, large items, lift booking, chain details…"></textarea>
    </div>
  </section>

  <section class="step" data-step="3" aria-labelledby="s3">
    <h2 id="s3" tabindex="-1">Where should we send your quote?</h2>
    <div class="form-grid">
      <div class="field">
        <label for="name">Full name</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
        <span class="error-msg" data-err="name"></span>
      </div>
      <div class="field">
        <label for="phone">Phone</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
        <span class="error-msg" data-err="phone"></span>
      </div>
      <div class="field full">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
        <span class="error-msg" data-err="email"></span>
      </div>
      <fieldset class="field full">
        <legend>Best time for a call</legend>
        <div class="choice-grid">
          <label class="choice"><input type="radio" name="callTime" value="Morning" /><span>Morning</span></label>
          <label class="choice"><input type="radio" name="callTime" value="Afternoon" /><span>Afternoon</span></label>
          <label class="choice"><input type="radio" name="callTime" value="Evening" /><span>Evening</span></label>
          <label class="choice"><input type="radio" name="callTime" value="Email only" /><span>Email only</span></label>
        </div>
      </fieldset>
      <div class="field full">
        <label class="choice" style="display:block"><input type="checkbox" name="consent" required /><span>I agree to be contacted about my quote, as set out in the <a href="/privacy-policy/" target="_blank" rel="noopener">privacy policy</a>.</span></label>
        <span class="error-msg" data-err="consent"></span>
      </div>
    </div>
  </section>

  <div class="form-nav">
    <button type="button" class="btn btn-ghost" data-back hidden>← Back</button>
    <button type="button" class="btn btn-primary btn-lg" data-next style="margin-left:auto">Continue <Icon name="arrow" /></button>
    <button type="submit" class="btn btn-primary btn-lg" data-submit hidden style="margin-left:auto">Get my free quote <Icon name="arrow" /></button>
  </div>
  <div class="form-status" role="status" aria-live="polite" data-status></div>
</form>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  if (form) {
    const steps = [...form.querySelectorAll<HTMLElement>('.step')];
    const bars = [...form.querySelectorAll<HTMLElement>('.progress li')];
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
    const back = form.querySelector<HTMLButtonElement>('[data-back]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const openedAt = Date.now();
    let current = 0;

    // Date: today or later
    const date = form.elements.namedItem('moveDate') as HTMLInputElement;
    date.min = new Date().toISOString().split('T')[0];

    // Prefill from query string (hero quick-quote, service/route/city pages)
    const qs = new URLSearchParams(location.search);
    const set = (name: string, val: string | null) => {
      if (!val) return;
      const el = form.elements.namedItem(name);
      if (el instanceof RadioNodeList) { [...el].forEach((r) => { if ((r as HTMLInputElement).value === val) (r as HTMLInputElement).checked = true; }); }
      else if (el instanceof HTMLSelectElement) { [...el.options].forEach((o) => { if (o.text === val) el.value = o.value || o.text; }); }
      else if (el instanceof HTMLInputElement) el.value = val;
    };
    set('fromPostcode', qs.get('from'));
    set('toPostcode', qs.get('to'));
    set('size', qs.get('size'));
    set('moveType', qs.get('type'));
    set('moveDate', qs.get('date'));

    const postcode = /^[A-Za-z]{1,2}\d[A-Za-z\d]?(\s*\d[A-Za-z]{2})?$/;
    const rules: Record<string, (v: string, f: HTMLFormElement) => string> = {
      moveType: (_v, f) => (f.querySelector('input[name=moveType]:checked') ? '' : 'Please choose a type of move.'),
      size: (v) => (v ? '' : 'Please select the size.'),
      fromPostcode: (v) => (postcode.test(v.trim()) ? '' : 'Enter a UK postcode, e.g. M1 1AA.'),
      toPostcode: (v) => (postcode.test(v.trim()) ? '' : 'Enter a UK postcode, e.g. B1 1AA.'),
      fromAccess: (v) => (v ? '' : 'Please select an option.'),
      toAccess: (v) => (v ? '' : 'Please select an option.'),
      moveDate: (v) => (v && v >= date.min ? '' : 'Choose today or a future date.'),
      name: (v) => (v.trim().length >= 2 ? '' : 'Please enter your name.'),
      phone: (v) => (v.replace(/\D/g, '').length >= 10 ? '' : 'Enter a valid UK phone number.'),
      email: (v) => (/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()) ? '' : 'Enter a valid email address.'),
      consent: (_v, f) => ((f.elements.namedItem('consent') as HTMLInputElement).checked ? '' : 'Please tick to continue.'),
    };

    const validateStep = (i: number): boolean => {
      let ok = true;
      let firstBad: HTMLElement | null = null;
      steps[i].querySelectorAll<HTMLElement>('[data-err]').forEach((span) => {
        const name = span.dataset.err!;
        const el = form.elements.namedItem(name) as HTMLInputElement | RadioNodeList | null;
        const value = el instanceof RadioNodeList ? el.value : (el?.value ?? '');
        const msg = rules[name]?.(value, form) ?? '';
        span.textContent = msg;
        const input = el instanceof RadioNodeList ? (el[0] as HTMLElement) : (el as HTMLElement);
        input?.setAttribute('aria-invalid', msg ? 'true' : 'false');
        if (msg) { ok = false; firstBad ??= input; }
      });
      (firstBad as HTMLElement | null)?.focus();
      return ok;
    };

    const show = (i: number) => {
      current = i;
      steps.forEach((s, n) => s.classList.toggle('active', n === i));
      bars.forEach((b, n) => { b.classList.toggle('active', n === i); b.classList.toggle('done', n < i); });
      back.hidden = i === 0;
      next.hidden = i === steps.length - 1;
      submit.hidden = i !== steps.length - 1;
      steps[i].querySelector<HTMLElement>('h2')?.focus({ preventScroll: true });
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    next.addEventListener('click', () => { if (validateStep(current)) show(current + 1); });
    back.addEventListener('click', () => show(current - 1));
    form.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.target as HTMLElement).tagName === 'INPUT' && (e.target as HTMLInputElement).type !== 'checkbox') {
        e.preventDefault();
        if (current < steps.length - 1) next.click(); else form.requestSubmit();
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validateStep(current)) return;
      const fd = new FormData(form);
      // Spam checks: honeypot and implausibly fast submission
      if (fd.get('website') || Date.now() - openedAt < 4000) {
        window.location.href = '/thank-you/';
        return;
      }
      const data: Record<string, string> = {};
      fd.forEach((v, k) => { if (k !== 'website' && k !== 'extras') data[k] = String(v); });
      data.extras = fd.getAll('extras').join(', ') || 'None';
      data.page = location.href;
      const subject = `New quote request: ${data.moveType} (${data.fromPostcode} → ${data.toPostcode})`;
      const { endpoint, key, email, brand } = form.dataset;

      submit.disabled = true;
      status.className = 'form-status';
      try {
        if (endpoint) {
          const body: Record<string, string> = { ...data, subject, from_name: brand ?? 'Website', ...(key ? { access_key: key } : {}) };
          const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) });
          if (!res.ok) throw new Error('Request failed');
          window.location.href = '/thank-you/';
        } else {
          // No endpoint configured yet: fall back to the visitor's email app so the lead is never lost.
          const lines = Object.entries(data).map(([k, v]) => `${k}: ${v}`).join('\n');
          window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines)}`;
          status.className = 'form-status ok';
          status.textContent = 'Your email app should open with your details ready to send. If it did not, please call us instead.';
          submit.disabled = false;
        }
      } catch {
        status.className = 'form-status err';
        status.textContent = 'Sorry, we could not send your request. Please call us or email us directly and we will sort your quote.';
        submit.disabled = false;
      }
    });
  }
</script>

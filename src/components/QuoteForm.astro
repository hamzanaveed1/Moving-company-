---
import Icon from './Icon.astro';
import { site } from '../data/site';

// [value (also shown to the customer), icon]
const moveTypes: [string, string][] = [
  ['House move', 'home'],
  ['Flat / apartment', 'building'],
  ['Office / business', 'office'],
  ['Student / small move', 'van'],
  ['Storage only', 'warehouse'],
];
const sizes = ['Studio / a few items', '1 bedroom', '2 bedrooms', '3 bedrooms', '4 bedrooms', '5+ bedrooms', 'Office (small, 1–10 desks)', 'Office (larger)'];
const access = [
  'Ground floor / easy access',
  'Flat with a working lift',
  'Stairs, 1–2 floors (no lift)',
  'Stairs, 3+ floors (no lift)',
  'Not sure',
];
const extras = ['Packing service', 'Boxes and materials', 'Dismantle / rebuild furniture', 'Storage', 'Disconnect appliances', 'Piano / very heavy items'];
const stepNames = ['Your move', 'Addresses', 'Date & extras', 'Contact'];
---
<form class="form-card qf" id="quote-form" novalidate data-endpoint={site.formEndpoint} data-fallback={site.formFallbackEndpoint} data-key={site.formAccessKey} data-email={site.email} data-brand={site.name}>
  <!-- Honeypot: real people never see or fill this -->
  <div class="hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

  <!-- Progress -->
  <div class="qf-progress">
    <ol class="stepper" aria-label="Progress">
      {stepNames.map((n, i) => (
        <li class={i === 0 ? 'active' : ''} aria-current={i === 0 ? 'step' : undefined}>
          <span class="dot" aria-hidden="true"><b>{i + 1}</b><Icon name="tick" /></span>
          <span class="lbl">{n}</span>
        </li>
      ))}
    </ol>
    <p class="step-count" aria-hidden="true"><span data-stepnum>Step 1</span> of 4 · <span data-stepname>Your move</span></p>
  </div>

  <!-- Step 1 -->
  <section class="step active" data-step="0" aria-labelledby="s0">
    <div class="step-head">
      <h2 id="s0" tabindex="-1">What are you moving?</h2>
      <p>Pick the closest match. You can add details later.</p>
    </div>
    <fieldset class="field">
      <legend>Type of move</legend>
      <div class="opt-grid">
        {moveTypes.map(([label, icon]) => (
          <label class="opt"><input type="radio" name="moveType" value={label} required /><span><Icon name={icon} />{label}</span></label>
        ))}
      </div>
      <span class="error-msg" data-err="moveType"></span>
    </fieldset>
    <fieldset class="field">
      <legend>Property size</legend>
      <div class="chips">
        {sizes.map((s) => (
          <label class="chip"><input type="radio" name="size" value={s} required /><span>{s}</span></label>
        ))}
      </div>
      <span class="error-msg" data-err="size"></span>
    </fieldset>
  </section>

  <!-- Step 2 -->
  <section class="step" data-step="1" aria-labelledby="s1">
    <div class="step-head">
      <h2 id="s1" tabindex="-1">Where are you moving?</h2>
      <p>Postcodes and access tell us the crew, van and time we need to plan.</p>
    </div>
    <div class="route-cards">
      <div class="route-card">
        <div class="route-title"><Icon name="pin" /><strong>Pick-up</strong></div>
        <div class="field">
          <label for="fromPostcode">Postcode</label>
          <input id="fromPostcode" name="fromPostcode" type="text" autocomplete="postal-code" placeholder="e.g. M1 1AA" required />
          <span class="error-msg" data-err="fromPostcode"></span>
        </div>
        <div class="field">
          <label for="fromAccess">Access</label>
          <select id="fromAccess" name="fromAccess" required>
            <option value="">Select…</option>
            {access.map((a) => <option>{a}</option>)}
          </select>
          <span class="error-msg" data-err="fromAccess"></span>
        </div>
      </div>
      <div class="route-card">
        <div class="route-title"><Icon name="route" /><strong>Delivery</strong></div>
        <div class="field">
          <label for="toPostcode">Postcode</label>
          <input id="toPostcode" name="toPostcode" type="text" placeholder="e.g. B1 1AA" required />
          <span class="error-msg" data-err="toPostcode"></span>
        </div>
        <div class="field">
          <label for="toAccess">Access</label>
          <select id="toAccess" name="toAccess" required>
            <option value="">Select…</option>
            {access.map((a) => <option>{a}</option>)}
          </select>
          <span class="error-msg" data-err="toAccess"></span>
        </div>
      </div>
    </div>
    <p class="form-note">Long carries, narrow streets and parking limits change what we plan. Add anything like that in the notes on the next step.</p>
  </section>

  <!-- Step 3 -->
  <section class="step" data-step="2" aria-labelledby="s2">
    <div class="step-head">
      <h2 id="s2" tabindex="-1">When, and what else?</h2>
      <p>A flexible date can make your move easier to schedule.</p>
    </div>
    <div class="form-grid">
      <div class="field">
        <label for="moveDate">Preferred moving date</label>
        <input id="moveDate" name="moveDate" type="date" required />
        <span class="error-msg" data-err="moveDate"></span>
      </div>
      <fieldset class="field">
        <legend>Is your date flexible?</legend>
        <div class="segmented">
          <label><input type="radio" name="flexible" value="Fixed date" checked /><span>Fixed</span></label>
          <label><input type="radio" name="flexible" value="± 1–3 days" /><span>± 1–3 days</span></label>
          <label><input type="radio" name="flexible" value="Very flexible" /><span>Flexible</span></label>
        </div>
      </fieldset>
    </div>
    <fieldset class="field">
      <legend>Extras <span class="hint">(optional, tick any)</span></legend>
      <div class="chips">
        {extras.map((l) => (
          <label class="chip"><input type="checkbox" name="extras" value={l} /><span>{l}</span></label>
        ))}
      </div>
    </fieldset>
    <div class="field">
      <label for="notes">Anything we should know? <span class="hint">(optional)</span></label>
      <textarea id="notes" name="notes" rows="3" placeholder="Parking restrictions, large items, lift booking, chain details…"></textarea>
    </div>
  </section>

  <!-- Step 4 -->
  <section class="step" data-step="3" aria-labelledby="s3">
    <div class="step-head">
      <h2 id="s3" tabindex="-1">Where should we send your quote?</h2>
      <p>We will review your move and reply with a written fixed price.</p>
    </div>
    <dl class="summary" aria-label="Your move so far">
      <div><dt>Move</dt><dd data-sum="type">–</dd></div>
      <div><dt>Size</dt><dd data-sum="size">–</dd></div>
      <div><dt>Route</dt><dd data-sum="route">–</dd></div>
      <div><dt>Date</dt><dd data-sum="date">–</dd></div>
    </dl>
    <div class="form-grid">
      <div class="field">
        <label for="name">Full name</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
        <span class="error-msg" data-err="name"></span>
      </div>
      <div class="field">
        <label for="phone">Phone</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
        <span class="error-msg" data-err="phone"></span>
      </div>
      <div class="field full">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
        <span class="error-msg" data-err="email"></span>
      </div>
      <fieldset class="field full">
        <legend>Best time for a call</legend>
        <div class="chips">
          {['Morning', 'Afternoon', 'Evening', 'Email only'].map((t) => (
            <label class="chip"><input type="radio" name="callTime" value={t} /><span>{t}</span></label>
          ))}
        </div>
      </fieldset>
      <div class="field full">
        <label class="consent"><input type="checkbox" name="consent" required /><span>I agree to be contacted about my quote, as set out in the <a href="/privacy-policy/" target="_blank" rel="noopener">privacy policy</a>.</span></label>
        <span class="error-msg" data-err="consent"></span>
      </div>
    </div>
  </section>

  <!-- Actions -->
  <div class="qf-actions">
    <button type="button" class="btn btn-ghost" data-back hidden><Icon name="arrow" class="flip" /> Back</button>
    <button type="button" class="btn btn-primary btn-lg" data-next>Continue <Icon name="arrow" /></button>
    <button type="submit" class="btn btn-primary btn-lg" data-submit hidden>Get my free quote <Icon name="arrow" /></button>
  </div>
  <p class="qf-assure"><Icon name="lock" /> Free, no obligation. We only use your details to prepare your quote.</p>
  <div class="form-status" role="status" aria-live="polite" data-status></div>
</form>

<script>
  import { sendLead } from '../scripts/send-lead';
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  if (form) {
    const steps = [...form.querySelectorAll<HTMLElement>('.step')];
    const items = [...form.querySelectorAll<HTMLElement>('.stepper li')];
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
    const back = form.querySelector<HTMLButtonElement>('[data-back]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const stepNum = form.querySelector<HTMLElement>('[data-stepnum]')!;
    const stepName = form.querySelector<HTMLElement>('[data-stepname]')!;
    const names = items.map((li) => li.querySelector('.lbl')!.textContent!);
    const openedAt = Date.now();
    let current = 0;

    // Date: today or later
    const date = form.elements.namedItem('moveDate') as HTMLInputElement;
    date.min = new Date().toISOString().split('T')[0];

    // Prefill from query string (hero quick-quote, service/route/city pages)
    const qs = new URLSearchParams(location.search);
    const set = (name: string, val: string | null) => {
      if (!val) return;
      const el = form.elements.namedItem(name);
      if (el instanceof RadioNodeList) { [...el].forEach((r) => { if ((r as HTMLInputElement).value === val) (r as HTMLInputElement).checked = true; }); }
      else if (el instanceof HTMLSelectElement) { [...el.options].forEach((o) => { if (o.text === val) el.value = o.value || o.text; }); }
      else if (el instanceof HTMLInputElement) el.value = val;
    };
    set('fromPostcode', qs.get('from'));
    set('toPostcode', qs.get('to'));
    set('size', qs.get('size'));
    set('moveType', qs.get('type'));
    set('moveDate', qs.get('date'));

    // Tie each error message to its field so screen readers announce it
    form.querySelectorAll<HTMLElement>('[data-err]').forEach((span) => {
      const name = span.dataset.err!;
      span.id = `err-${name}`;
      span.setAttribute('role', 'alert');
      const el = form.elements.namedItem(name);
      const target = el instanceof RadioNodeList ? (el[0] as HTMLElement) : (el as HTMLElement | null);
      target?.setAttribute('aria-describedby', span.id);
    });

    const postcode = /^[A-Za-z]{1,2}\d[A-Za-z\d]?(\s*\d[A-Za-z]{2})?$/;
    const rules: Record<string, (v: string, f: HTMLFormElement) => string> = {
      moveType: (v) => (v ? '' : 'Please choose a type of move.'),
      size: (v) => (v ? '' : 'Please choose the size.'),
      fromPostcode: (v) => (postcode.test(v.trim()) ? '' : 'Enter a UK postcode, e.g. M1 1AA.'),
      toPostcode: (v) => (postcode.test(v.trim()) ? '' : 'Enter a UK postcode, e.g. B1 1AA.'),
      fromAccess: (v) => (v ? '' : 'Please select an option.'),
      toAccess: (v) => (v ? '' : 'Please select an option.'),
      moveDate: (v) => (v && v >= date.min ? '' : 'Choose today or a future date.'),
      name: (v) => (v.trim().length >= 2 ? '' : 'Please enter your name.'),
      phone: (v) => (v.replace(/\D/g, '').length >= 10 ? '' : 'Enter a valid UK phone number.'),
      email: (v) => (/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()) ? '' : 'Enter a valid email address.'),
      consent: (_v, f) => ((f.elements.namedItem('consent') as HTMLInputElement).checked ? '' : 'Please tick to continue.'),
    };

    const validateStep = (i: number): boolean => {
      let ok = true;
      let firstBad: HTMLElement | null = null;
      steps[i].querySelectorAll<HTMLElement>('[data-err]').forEach((span) => {
        const name = span.dataset.err!;
        const el = form.elements.namedItem(name) as HTMLInputElement | RadioNodeList | null;
        const value = el instanceof RadioNodeList ? el.value : (el?.value ?? '');
        const msg = rules[name]?.(value, form) ?? '';
        span.textContent = msg;
        const input = el instanceof RadioNodeList ? (el[0] as HTMLElement) : (el as HTMLElement);
        input?.setAttribute('aria-invalid', msg ? 'true' : 'false');
        input?.closest('.field, .route-card')?.classList.toggle('has-error', !!msg);
        if (msg) { ok = false; firstBad ??= input; }
      });
      (firstBad as HTMLElement | null)?.focus();
      return ok;
    };

    // Clear an error as soon as the customer fixes the field
    form.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (!t.name || !rules[t.name]) return;
      const span = form.querySelector<HTMLElement>(`[data-err="${t.name}"]`);
      if (span?.textContent && !rules[t.name](t.type === 'radio' ? (form.elements.namedItem(t.name) as RadioNodeList).value : t.value, form)) {
        span.textContent = '';
        t.setAttribute('aria-invalid', 'false');
        t.closest('.field, .route-card')?.classList.remove('has-error');
      }
    });

    const fmtDate = (v: string) => (v ? new Date(v + 'T12:00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' }) : '–');
    const fillSummary = () => {
      const g = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement | RadioNodeList)?.value ?? '') || '–';
      const put = (k: string, v: string) => { const el = form.querySelector<HTMLElement>(`[data-sum="${k}"]`); if (el) el.textContent = v; };
      put('type', g('moveType'));
      put('size', g('size'));
      put('route', `${g('fromPostcode').toUpperCase()} → ${g('toPostcode').toUpperCase()}`);
      put('date', fmtDate((form.elements.namedItem('moveDate') as HTMLInputElement).value));
    };

    const show = (i: number) => {
      current = i;
      steps.forEach((s, n) => s.classList.toggle('active', n === i));
      items.forEach((li, n) => {
        li.classList.toggle('active', n === i);
        li.classList.toggle('done', n < i);
        if (n === i) li.setAttribute('aria-current', 'step'); else li.removeAttribute('aria-current');
      });
      stepNum.textContent = `Step ${i + 1}`;
      stepName.textContent = names[i];
      back.hidden = i === 0;
      next.hidden = i === steps.length - 1;
      submit.hidden = i !== steps.length - 1;
      if (i === steps.length - 1) fillSummary();
      status.className = 'form-status';
      steps[i].querySelector<HTMLElement>('h2')?.focus({ preventScroll: true });
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    next.addEventListener('click', () => { if (validateStep(current)) show(current + 1); });
    back.addEventListener('click', () => show(current - 1));
    form.addEventListener('keydown', (e) => {
      const t = e.target as HTMLInputElement;
      if (e.key === 'Enter' && t.tagName === 'INPUT' && t.type !== 'checkbox' && t.type !== 'radio') {
        e.preventDefault();
        if (current < steps.length - 1) next.click(); else form.requestSubmit();
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validateStep(current)) return;
      const fd = new FormData(form);
      // Spam checks: honeypot and implausibly fast submission
      if (fd.get('website') || Date.now() - openedAt < 4000) {
        window.location.href = '/thank-you/';
        return;
      }
      const data: Record<string, string> = {};
      fd.forEach((v, k) => { if (k !== 'website' && k !== 'extras') data[k] = String(v); });
      data.extras = fd.getAll('extras').join(', ') || 'None';
      data.page = location.href;
      const subject = `New quote request: ${data.moveType} (${data.fromPostcode} → ${data.toPostcode})`;
      const { endpoint, fallback, key, email, brand } = form.dataset;

      submit.disabled = true;
      status.className = 'form-status';
      try {
        if (endpoint || (fallback && key)) {
          await sendLead({ endpoint, fallback, key, body: { ...data, subject, from_name: brand ?? 'Website' } });
          window.location.href = '/thank-you/';
        } else {
          // No endpoint configured yet: fall back to the visitor's email app so the lead is never lost.
          const lines = Object.entries(data).map(([k, v]) => `${k}: ${v}`).join('\n');
          window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines)}`;
          status.className = 'form-status ok';
          status.textContent = 'Your email app should open with your details ready to send. If it did not, please email us instead.';
          submit.disabled = false;
        }
      } catch {
        // Never lose a lead: offer a ready-to-send email with the same details.
        const lines = Object.entries(data).map(([k, v]) => `${k}: ${v}`).join('\n');
        const link = document.createElement('a');
        link.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines)}`;
        link.textContent = 'email us your details';
        status.className = 'form-status err';
        status.textContent = 'Sorry, we could not send your request just now. Please ';
        status.append(link, '. Your details are filled in for you.');
        submit.disabled = false;
      }
    });
  }
</script>

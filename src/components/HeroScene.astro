---
import Icon from './Icon.astro';
import { routes } from '../data/routes';

// The route shown in the caption changes each loop (real routes from our data). First = London to Manchester.
const rt = routes.map((r) => ({ from: r.from, to: r.to, miles: r.miles, drive: r.drive, href: `/routes/${r.slug}/` }));
const first = rt[0];

// ---- seamless skylines: buildings tile every `period` units so the loop can snap back invisibly ----
function rng(seed: number) {
  let s = seed >>> 0;
  return () => {
    s = (s + 0x6d2b79f5) >>> 0;
    let t = s;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
interface B { x: number; w: number; h: number; win: { x: number; y: number; on: boolean }[] }
function tile(period: number, seed: number, minH: number, maxH: number, minW: number, maxW: number, windows: boolean): B[] {
  const r = rng(seed);
  const out: B[] = [];
  let x = 0;
  while (x < period) {
    let w = minW + r() * (maxW - minW);
    if (period - (x + w) < minW) w = period - x; // last building closes the tile exactly
    const h = minH + r() * (maxH - minH);
    const win: B['win'] = [];
    if (windows) {
      const cols = Math.max(1, Math.floor((w - 10) / 14));
      const rows = Math.max(1, Math.floor((h - 12) / 18));
      for (let i = 0; i < cols; i++) for (let j = 0; j < rows; j++) if (r() > 0.25) win.push({ x: 7 + i * ((w - 14) / cols), y: 9 + j * ((h - 14) / rows), on: r() > 0.6 });
    }
    out.push({ x, w, h, win });
    x += w;
  }
  return out;
}
const FAR = 200, NEAR = 300;
const far = tile(FAR, 11, 70, 150, 34, 70, false);
const near = tile(NEAR, 23, 48, 118, 34, 60, true);
const farCopies = [0, 1, 2, 3]; // 600 + 200 needed
const nearCopies = [0, 1, 2];   // 600 + 300 needed (extra copy = safety)
const lamps = Array.from({ length: 6 }, (_, i) => i * 150); // 150 period, 3 periods of travel
const dashes = Array.from({ length: 9 }, (_, i) => i * 90);  // 90 period, 4 periods of travel
---
<div class="scene-card" data-scene data-routes={JSON.stringify(rt)}>
  <svg class="scene" viewBox="0 0 600 580" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Animated illustration: a Loadby removal van loads boxes at point A, drives across the city and delivers them at point B." focusable="false">
    <defs>
      <linearGradient id="sc-sky" x1="0" y1="0" x2="0" y2="1">
        <stop class="sc-sky-a" offset="0" />
        <stop class="sc-sky-b" offset=".5" />
        <stop class="sc-sky-c" offset="1" />
      </linearGradient>
      <radialGradient id="sc-sun"><stop class="sc-sun-glow" offset="0" stop-opacity=".95" /><stop class="sc-sun-glow" offset="1" stop-opacity="0" /></radialGradient>
      <g id="sc-far">
        {far.map((b) => <rect class={b.h > 110 ? 'sc-far-b' : 'sc-far-b t'} x={b.x.toFixed(1)} y={(372 - b.h).toFixed(1)} width={b.w.toFixed(1)} height={b.h.toFixed(1)} />)}
      </g>
      <g id="sc-near">
        {near.map((b) => (
          <g>
            <rect class="sc-near-b" x={b.x.toFixed(1)} y={(372 - b.h).toFixed(1)} width={b.w.toFixed(1)} height={b.h.toFixed(1)} />
            {b.win.map((w) => <rect class={w.on ? 'sc-w-on' : 'sc-w-off'} x={(b.x + w.x).toFixed(1)} y={(372 - b.h + w.y).toFixed(1)} width="6" height="9" rx="1.5" opacity={w.on ? 0.95 : 0.55} />)}
          </g>
        ))}
      </g>
      <g id="sc-box"><rect width="30" height="26" rx="2" fill="#d9a566" /><rect width="30" height="6" rx="2" fill="#ecc48f" /><rect x="11" width="8" height="15" fill="#c98a4a" opacity=".85" /></g>
    </defs>

    <!-- sky, sun, clouds -->
    <rect width="600" height="580" fill="url(#sc-sky)" />
    <g class="sc-stars" aria-hidden="true">{[[60,40],[140,90],[230,30],[310,70],[380,25],[520,60],[560,120],[90,150],[470,35],[270,120],[20,100],[420,95]].map(([x, y], i) => <circle cx={x} cy={y} r={i % 3 === 0 ? 1.6 : 1.1} class="sc-star" style={`animation-delay:${-(i * 0.7).toFixed(1)}s`} />)}</g>
    <g class="sc-sun"><circle cx="440" cy="150" r="120" fill="url(#sc-sun)" /><circle class="sc-sun-core" cx="440" cy="150" r="40" /></g>
    <g class="sc-cloud c1" opacity=".9"><ellipse cx="0" cy="0" rx="46" ry="14" /><ellipse cx="-18" cy="-10" rx="22" ry="15" /><ellipse cx="14" cy="-14" rx="26" ry="18" /></g>
    <g class="sc-cloud c2" opacity=".75"><ellipse cx="0" cy="0" rx="36" ry="11" /><ellipse cx="-14" cy="-8" rx="17" ry="12" /><ellipse cx="12" cy="-11" rx="20" ry="14" /></g>
    <g class="sc-cloud c3" opacity=".65"><ellipse cx="0" cy="0" rx="52" ry="15" /><ellipse cx="-20" cy="-11" rx="24" ry="16" /><ellipse cx="16" cy="-15" rx="28" ry="19" /></g>

    <!-- skyline layers (parallax, synced to the truck) -->
    <g class="sc-layer sc-far-l">{farCopies.map((k) => <use href="#sc-far" x={k * FAR} />)}</g>
    <g class="sc-layer sc-near-l">{nearCopies.map((k) => <use href="#sc-near" x={k * NEAR} />)}</g>

    <!-- A: pick-up building and B: new home -->
    <g>
      <rect x="34" y="294" width="54" height="78" fill="#1a3a6b" />
      <rect x="34" y="294" width="54" height="6" fill="#12305c" />
      {[0, 1, 2, 3].map((r) => [0, 1, 2].map((c) => <rect x={42 + c * 15} y={304 + r * 15} width="8" height="9" rx="1.5" fill={(r + c) % 3 === 0 ? '#ffd27a' : '#3a66a6'} opacity=".9" />))}
      <rect x="55" y="354" width="12" height="18" rx="2" fill="#f5a524" />
    </g>
    <g>
      <rect x="500" y="324" width="72" height="48" fill="#fbf3e4" />
      <polygon points="490,326 536,288 582,326" fill="#12305c" />
      <rect x="522" y="342" width="14" height="30" rx="2" fill="#f5a524" />
      <rect x="506" y="334" width="12" height="12" rx="2" fill="#bfe0f5" /><rect x="552" y="334" width="12" height="12" rx="2" fill="#bfe0f5" />
      <rect x="554" y="292" width="10" height="22" fill="#b8803f" />
    </g>

    <!-- ground, lamp posts, road -->
    <rect y="372" width="600" height="208" fill="#1f2c47" />
    <rect y="372" width="600" height="8" fill="#3e5176" />
    <g class="sc-layer sc-lamp-l">{lamps.map((x) => <g transform={`translate(${x + 40} 372)`}><rect x="-1.5" y="-46" width="3" height="46" fill="#0f1b30" /><rect x="-1.5" y="-46" width="13" height="3" fill="#0f1b30" /><circle cx="11" cy="-42" r="4" fill="#ffd27a" /></g>)}</g>
    <rect y="392" width="600" height="76" fill="#2a3a58" />
    <rect y="392" width="600" height="3" fill="#3e5176" />
    <rect y="468" width="600" height="112" fill="#172238" />
    <g class="sc-layer sc-dash-l">{dashes.map((x) => <rect x={x} y="428" width="40" height="5" rx="2.5" fill="#f4e7c4" opacity=".85" />)}</g>

    <!-- route arc from A to B: dotted guide + amber progress that fills as the van drives -->
    <path d="M60 262 C 165 80, 425 80, 530 276" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width="6" stroke-linecap="round" />
    <path d="M60 262 C 165 80, 425 80, 530 276" fill="none" stroke="#12305c" stroke-opacity=".45" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="1 9" />
    <path class="sc-progress" pathLength="1" d="M60 262 C 165 80, 425 80, 530 276" fill="none" stroke="#f5a524" stroke-width="4.5" stroke-linecap="round" />

    <!-- boxes waiting at A and delivered at B -->
    <g class="sc-pile sc-pile-a"><use href="#sc-box" x="96" y="346" /><use href="#sc-box" x="124" y="346" /><use href="#sc-box" x="110" y="321" /></g>
    <g class="sc-pile sc-pile-b"><use href="#sc-box" x="396" y="346" /><use href="#sc-box" x="424" y="346" /><use href="#sc-box" x="410" y="321" /></g>

    <!-- the van (faces right) -->
    <g class="sc-truck">
      <g transform="translate(30 452) scale(.4)">
        <g class="sc-fx" stroke="#fff" stroke-linecap="round" stroke-opacity=".75"><path d="M-30 -120 h-70" stroke-width="7" /><path d="M-10 -80 h-90" stroke-width="7" /><path d="M-30 -40 h-60" stroke-width="7" /></g>
        <ellipse cx="190" cy="2" rx="205" ry="12" fill="#000" opacity=".25" />
        <g class="sc-body">
          <rect x="0" y="-178" width="262" height="146" rx="16" fill="#fff" />
          <rect x="0" y="-62" width="262" height="30" fill="#12305c" />
          <rect x="0" y="-92" width="262" height="12" fill="#f5a524" />
          <image href="/logo-mark.svg" x="26" y="-166" width="56" height="62" />
          <text x="98" y="-118" font-family="Manrope Variable, system-ui, sans-serif" font-weight="800" font-size="36" fill="#0c1f3d" letter-spacing="-1">Load<tspan fill="#b36200">by</tspan></text>
          <path d="M262 -150 L322 -150 Q346 -148 358 -118 L378 -84 Q386 -70 386 -50 L386 -32 L262 -32 Z" fill="#fff" />
          <path d="M276 -138 L318 -138 Q334 -136 342 -116 L352 -94 L276 -94 Z" fill="#a9d4f0" />
          <rect x="262" y="-62" width="124" height="30" fill="#12305c" />
          <rect x="372" y="-76" width="16" height="12" rx="4" fill="#ffd27a" />
          <rect x="372" y="-50" width="20" height="14" rx="5" fill="#161b27" />
        </g>
        {[78, 318].map((cx) => (
          <g>
            <circle cx={cx} cy="-24" r="32" fill="#161b27" />
            <g class="sc-wheel" style={`transform-origin:${cx}px -24px`}>
              <circle cx={cx} cy="-24" r="16" fill="#cfd6e4" />
              <path d={`M${cx} -38 V-10 M${cx - 14} -24 H${cx + 14}`} stroke="#161b27" stroke-width="5" stroke-linecap="round" />
              <circle cx={cx} cy="-24" r="5" fill="#161b27" />
            </g>
          </g>
        ))}
      </g>
    </g>

    <!-- pins -->
    <g transform="translate(60 262)">
      <circle class="sc-ring" r="12" fill="none" stroke="#f5a524" stroke-width="2" />
      <g transform="translate(0 6)"><path d="M0 0 C-12 -15 -16 -22 -16 -29 A16 16 0 1 1 16 -29 C16 -22 12 -15 0 0Z" transform="translate(0 0) scale(1)" fill="#f5a524" /><circle cy="-29" r="9" fill="#fff" /><text y="-25" text-anchor="middle" font-family="Manrope Variable, system-ui, sans-serif" font-weight="800" font-size="12" fill="#0c1f3d">A</text></g>
    </g>
    <g transform="translate(530 276)">
      <circle class="sc-ring r2" r="12" fill="none" stroke="#1c8a5c" stroke-width="2" />
      <g transform="translate(0 6)"><path d="M0 0 C-12 -15 -16 -22 -16 -29 A16 16 0 1 1 16 -29 C16 -22 12 -15 0 0Z" fill="#1c8a5c" /><circle cy="-29" r="9" fill="#fff" /><text y="-25" text-anchor="middle" font-family="Manrope Variable, system-ui, sans-serif" font-weight="800" font-size="12" fill="#0c1f3d">B</text></g>
    </g>
  </svg>

  <!-- HTML overlays (crisp text, easy to update from the route list) -->
  <div class="scene-route" aria-live="off">
    <span class="pin a" aria-hidden="true">A</span><span data-from>{first.from}</span>
    <Icon name="arrow" />
    <span class="pin b" aria-hidden="true">B</span><span data-to>{first.to}</span>
  </div>
  <button class="scene-pause" type="button" aria-pressed="false" aria-label="Pause animation" data-pause>
    <Icon name="pause" class="i-pause" /><Icon name="play" class="i-play" />
  </button>
  <div class="scene-foot">
    <span class="scene-stats"><b data-miles>~{first.miles} miles</b><span data-drive>{first.drive}</span></span>
    <a class="scene-link" data-routelink href={first.href}>View route <Icon name="arrow" /></a>
  </div>
  <div class="scene-done" aria-hidden="true"><Icon name="check" /> Delivered</div>
</div>

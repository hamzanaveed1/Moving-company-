---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, abs } from '../data/site';
import { businessSchema, websiteSchema } from '../lib/seo';
import { criticalFonts } from './fonts';

interface Props {
  title: string;
  description: string;
  /** Path or absolute URL of a 1200x630 social image */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  /** Extra class for <body> */
  bodyClass?: string;
  /** Load the AdSense script on this page (only has an effect if PUBLIC_ADSENSE_CLIENT is set) */
  ads?: boolean;
  /** Extra JSON-LD objects for this page */
  schema?: object[];
}
const { title, description, image = '/og-default.png', imageAlt, noindex = false, type = 'website', publishedAt, updatedAt, ads = false, bodyClass = '', schema = [] } = Astro.props;

// Append the brand only if it keeps the title within ~60 characters
// Vercel Web Analytics: only on Vercel builds (Vercel sets VERCEL=1). Cookieless; needs 'Enable' in the Vercel dashboard.
const vercelAnalytics = Boolean(process.env.VERCEL) && !noindex;
const brandSuffix = ` | ${site.name}`;
const fullTitle = Astro.url.pathname === '/' ? title : title.length + brandSuffix.length <= 60 ? title + brandSuffix : title;
const canonical = abs(Astro.url.pathname);
const ogImage = image.startsWith('http') ? image : abs(image);
const jsonLd = [businessSchema(), websiteSchema(), ...schema];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1016" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <!-- Applies the saved/system theme before first paint (no white flash in dark mode). Tiny, same-origin, cached. -->
    <script is:inline src="/theme-init.js"></script>
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
    {site.googleAnalyticsMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalyticsMeasurementId}`}></script>
        <script define:vars={{ measurementId: site.googleAnalyticsMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){{dataLayer.push(arguments);}}
          gtag('js', new Date());
          gtag('config', measurementId);
        </script>
      </>
    )}
    {vercelAnalytics && <meta name="vercel-analytics" content="on" />}
    <meta name="format-detection" content="telephone=yes" />

    {criticalFonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <!-- Tab icons. ?v= is a cache-buster: browsers keep favicons for a very long time, so bump it whenever the logo changes. -->
    <link rel="icon" href="/favicon.ico?v=4" sizes="48x48 32x32 16x16" />
    <link rel="icon" href="/favicon.svg?v=4" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href="/rss.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {type === 'article' && (updatedAt || publishedAt) && <meta property="article:modified_time" content={(updatedAt ?? publishedAt)!.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {ads && site.adsenseClient && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`} crossorigin="anonymous"></script>}
    {jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class={bodyClass || undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script>import '../scripts/ui.ts';</script>
    <script>import '../scripts/theme.ts';</script>
    <script>import '../scripts/analytics.ts';</script>
  </body>
</html>
